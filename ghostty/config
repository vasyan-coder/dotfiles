# Font for zsh + Powerlevel10k
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

background-opacity = 0.85
background-blur = 30

# Slightly thicker text on macOS, optional but usually nicer with JetBrains Mono
font-thicken = true
font-thicken-strength = 70

# Better terminal behavior
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# Cursor
cursor-style = block
cursor-style-blink = false

# Отключает macOS window decorations, а вместе с ними native tabs
# window-decoration = none

# --- tmux integration: Cmd behaves like terminal-native shortcuts ---

# Не создаём native Ghostty tab, чтобы AeroSpace не ломал layout
keybind = cmd+t=text:\x01c

# Закрыть текущий tmux pane/window
keybind = cmd+w=text:\x01x

# Принудительно закрыть tmux window
keybind = cmd+shift+w=text:\x01X

# iTerm-like splits
keybind = cmd+d=text:\x01v
keybind = cmd+shift+d=text:\x01s

# Переключение tmux sessions (prefix + ( / ) → switch-client -p/-n)
keybind = cmd+left=text:\x01(
keybind = cmd+right=text:\x01)

# Переключение tmux windows
keybind = cmd+shift+left=text:\x01p
keybind = cmd+shift+right=text:\x01n

# Zoom pane
keybind = cmd+enter=text:\x01z

# Rename tmux window
keybind = cmd+r=text:\x01,

# Reload tmux config
keybind = cmd+shift+r=text:\x01r

# Переключение по номерам, как Cmd+1..9 в GUI tabs
keybind = cmd+1=text:\x011
keybind = cmd+2=text:\x012
keybind = cmd+3=text:\x013
keybind = cmd+4=text:\x014
keybind = cmd+5=text:\x015
keybind = cmd+6=text:\x016
keybind = cmd+7=text:\x017
keybind = cmd+8=text:\x018
keybind = cmd+9=text:\x019

keybind = cmd+digit1=text:\x01\x31
keybind = cmd+digit2=text:\x01\x32
keybind = cmd+digit3=text:\x01\x33
keybind = cmd+digit4=text:\x01\x34
keybind = cmd+digit5=text:\x01\x35
keybind = cmd+digit6=text:\x01\x36
keybind = cmd+digit7=text:\x01\x37
keybind = cmd+digit8=text:\x01\x38
keybind = cmd+digit9=text:\x01\x39
keybind = cmd+digit0=text:\x01\x30

# --- tmux sessions like higher-level iTerm tabs/workspaces ---

# Просмотр всех tmux-сессий/окон/pane
keybind = cmd+shift+o=text:\x01S

# Переключение между tmux-сессиями, как браузерные tab shortcuts
keybind = cmd+shift+left_bracket=text:\x01(
keybind = cmd+shift+right_bracket=text:\x01)

# Вернуться в последнюю активную tmux-сессию
keybind = cmd+shift+l=text:\x01L

# Создать новую tmux-сессию
keybind = cmd+shift+t=text:\x01N
